    "Drag to aim! It stays pointed this way the whole match, no matter how it bounces.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zieh zum Zielen! Die Richtung bleibt das ganze Match gleich, egal wie er abprallt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Arrastra para apuntar! Mantiene esa dirección toda la partida, rebote como rebote."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glisse pour viser ! La direction reste fixe tout le match, peu importe les rebonds."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste para mirar! A mira fica nessa direção a partida toda, não importa como ela quique."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage ca să țintești! Direcția rămâne fixă tot meciul, oricum ar ricoșa."
          }
        }
      }
    },
    "Drain": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entzug"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Drenaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Drain"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreno"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Drenare"
          }
        }
      }
    },
    "Drains 1 more per second, and while latched on the enemy takes 10% more damage from everything.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Saugt 1 mehr pro Sekunde, und solange er dranhängt, nimmt der Gegner 10% mehr Schaden von allem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Drena 1 más por segundo y, mientras está enganchado, el enemigo recibe un 10% más de daño de todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Draine 1 de plus par seconde, et tant qu'il est accroché, l'ennemi subit 10% de dégâts en plus de toutes les sources."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Drena 1 a mais por segundo, e enquanto preso o inimigo leva 10% a mais de dano de tudo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Drenează cu 1 mai mult pe secundă, iar cât e agățat, inamicul primește cu 10% mai multe daune din orice sursă."
          }
        }
      }
    },
    "Drops ice bombs that burst into a ring of icy spikes. Every 2 spike hits freeze the enemy solid.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt Eisbomben, die in einen Ring aus Eisstacheln zerplatzen. Alle 2 Stacheltreffer friert der Gegner komplett ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta bombas de hielo que estallan en un anillo de picos helados. Cada 2 golpes de pico congelan al enemigo por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lâche des bombes de glace qui éclatent en un anneau de pics glacés. Tous les 2 pics qui touchent, l'ennemi est gelé net."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solta bombas de gelo que explodem num anel de espinhos gelados. A cada 2 acertos o inimigo congela."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă bombe de gheață care explodează într-un inel de țepi de gheață. La fiecare 2 țepi care lovesc, inamicul îngheață bocnă."
          }
        }
      }
    },
