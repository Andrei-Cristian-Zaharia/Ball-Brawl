    "Couldn't check the code. Make sure you're online and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code konnte nicht geprüft werden. Prüf deine Verbindung und versuch es nochmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comprobar el código. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier le code. Vérifie ta connexion et réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードを確認できませんでした。オンラインか確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드를 확인할 수 없어요. 온라인 상태인지 확인하고 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não deu para verificar o código. Confira sua conexão e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut verifica codul. Asigură-te că ești online și încearcă din nou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证兑换码。请确认已联网后重试。"
          }
        }
      }
    },
    "Couldn't reach %@.": {
