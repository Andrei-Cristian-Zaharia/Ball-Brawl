    "Paints a red danger zone that spreads out from where it stands. The enemy takes steady damage inside; Zone heals in its own turf.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Malt eine rote Gefahrenzone, die sich von seinem Standort ausbreitet. Der Gegner nimmt darin stetig Schaden; Zone heilt sich in seinem Revier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta una zona de peligro roja que se extiende desde donde está. El enemigo recibe daño constante dentro; Zone se cura en su terreno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peint une zone de danger rouge qui s'étend autour de lui. L'ennemi y subit des dégâts constants ; Zone se soigne sur son territoire."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinta uma zona de perigo vermelha que se espalha de onde está. O inimigo leva dano constante dentro; Zone se cura no seu território."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pictează o zonă roșie de pericol care se extinde din locul unde stă. Inamicul primește daune constante înăuntru; Zone se vindecă pe teritoriul lui."
          }
        }
      }
    },
