    "Harpoon hits bleed: 1.5 damage per second for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Harpunentreffer verursachen Blutung: 1,5 Schaden pro Sekunde für 2s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los arponazos causan sangrado: 1.5 de daño por segundo durante 2s."
          }
        },
        "fr": {
