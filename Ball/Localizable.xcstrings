    "Rolls bombs at the enemy that go off early if it gets close. Blasts set off nearby bombs in a chain reaction.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rollt Bomben auf den Gegner, die früher hochgehen, wenn er nahe kommt. Explosionen zünden nahe Bomben in einer Kettenreaktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza bombas rodando hacia el enemigo que explotan antes si se acerca. Las explosiones detonan bombas cercanas en cadena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait rouler des bombes vers l'ennemi qui explosent plus tôt s'il s'approche. Les explosions font sauter les bombes proches en réaction en chaîne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rola bombas no inimigo que explodem antes se ele chegar perto. Explosões detonam bombas próximas em reação em cadeia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostogolește bombe spre inamic care explodează mai devreme dacă se apropie. Exploziile detonează bombele din jur în reacție în lanț."
          }
        }
      }
    },
