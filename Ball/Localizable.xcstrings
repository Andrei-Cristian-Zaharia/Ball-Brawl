    "Shockwave reaches 30 further, and its hits slow the enemy by 30% for 1.5s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schockwelle reicht 30 weiter und verlangsamt den Gegner 1,5s lang um 30%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La onda llega 30 más lejos y sus golpes ralentizan al enemigo un 30% durante 1.5s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'onde de choc porte 30 plus loin et ralentit l'ennemi de 30% pendant 1.5s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A onda de choque alcança 30 a mais e deixa o inimigo 30% mais lento por 1.5s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unda de șoc ajunge cu 30 mai departe, iar loviturile ei încetinesc inamicul cu 30% timp de 1.5s."
          }
        }
      }
    },
    "Shockwaves come every 2.2s, plus a small extra one (4 damage) every 3s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schockwellen kommen alle 2.2s, plus eine kleine Extrawelle (4 Schaden) alle 3s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondas cada 2.2s, más una pequeña extra (4 de daño) cada 3s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondes de choc toutes les 2.2s, plus une petite onde bonus (4 dégâts) toutes les 3s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondas de choque a cada 2.2s, mais uma pequena extra (4 de dano) a cada 3s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Unde de șoc la fiecare 2.2s, plus una mică în plus (4 daune) la fiecare 3s."
          }
        }
      }
    },
