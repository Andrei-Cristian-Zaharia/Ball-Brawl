    "Beams burn: 2 damage per second for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Strahlen verbrennen: 2 Schaden pro Sekunde für 2s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los rayos queman: 2 de daño por segundo durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rayons brûlent : 2 dégâts par seconde pendant 2s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
