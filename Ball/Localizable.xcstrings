    "Charges from damage. For 5s everything it deals hits 40% harder.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. 5s lang trifft alles, was er austeilt, 40% härter."
