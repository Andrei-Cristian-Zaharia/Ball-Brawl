            "state": "translated",
            "value": "%@ rechazó tu invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a refusé ton invitation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が招待を断りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 초대를 거절했어요."
