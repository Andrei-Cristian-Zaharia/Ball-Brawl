    "Bolts bounce off one wall before breaking, and fire 8% faster.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bolzen prallen einmal von einer Wand ab, bevor sie zerbrechen, und feuern 8% schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los rayos rebotan en una pared antes de romperse y se disparan un 8% más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projectiles rebondissent sur un mur avant de se briser, et tirent 8% plus vite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os projéteis quicam numa parede antes de quebrar e saem 8% mais rápido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Proiectilele ricoșează dintr-un perete înainte să se spargă și se trag cu 8% mai repede."
          }
        }
      }
    },
