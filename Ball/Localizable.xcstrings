    "Invite sent to %@. Waiting for them to accept…": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung an %@ gesendet. Warte auf Annahme…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitación enviada a %@. Esperando que acepte…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation envoyée à %@. En attente de sa réponse…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@に招待を送りました。承認を待っています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님에게 초대를 보냈어요. 수락을 기다리는 중…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convite enviado para %@. Aguardando aceitar…"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitație trimisă către %@. Așteptăm să accepte…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已向 %@ 发送邀请。等待对方接受…"
          }
        }
      }
    },
    "It rests until the crusade resets tonight. Send in a teammate!": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ruht, bis der Kreuzzug heute Nacht zurückgesetzt wird. Schick ein Teammitglied rein!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descansa hasta que la Cruzada se reinicie esta noche. ¡Envía a un compañero!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se repose jusqu'à la réinitialisation de la Croisade ce soir. Envoie un coéquipier !"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜クルセードがリセットされるまで休憩中。仲間を送り込もう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 밤 원정이 초기화될 때까지 쉬어요. 다른 팀원을 보내 주세요!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela descansa até a Cruzada reiniciar à noite. Mande um aliado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se odihnește până se resetează cruciada diseară. Trimite un coechipier!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将休息到今晚远征重置。派一名队友上场吧！"
          }
        }
      }
    },
