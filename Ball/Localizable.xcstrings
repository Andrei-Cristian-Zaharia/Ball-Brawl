    "Steals 5% more health, and knife hits slow the enemy by 20% for 1s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stiehlt 5% mehr HP, und Messertreffer verlangsamen den Gegner 1s lang um 20%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Roba un 5% más de salud y los cuchillos ralentizan al enemigo un 20% durante 1s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vole 5% de vie en plus, et les couteaux ralentissent l'ennemi de 20% pendant 1s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouba 5% a mais de vida, e facadas deixam o inimigo 20% mais lento por 1s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fură cu 5% mai multă viață, iar cuțitele încetinesc inamicul cu 20% timp de 1s."
          }
        }
      }
    },
