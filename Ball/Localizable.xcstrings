    "It rests until the crusade resets tonight. Send in a teammate!": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ruht, bis der Kreuzzug heute Nacht zurückgesetzt wird. Schick ein Teammitglied rein!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descansa hasta que la Cruzada se reinicie esta noche. ¡Envía a un compañero!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il se repose jusqu'à la réinitialisation de la Croisade ce soir. Envoie un coéquipier !"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela descansa até a Cruzada reiniciar à noite. Mande um aliado!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se odihnește până se resetează cruciada diseară. Trimite un coechipier!"
