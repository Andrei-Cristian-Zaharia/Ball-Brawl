    "Wall bounces heal 1 more, and thorny touches make the enemy bleed: 1.5 damage per second for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandabpraller heilen 1 mehr, und dornige Berührungen verursachen Blutung: 1,5 Schaden pro Sekunde für 2s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los rebotes en pared curan 1 más y los toques espinosos hacen sangrar al enemigo: 1.5 de daño por segundo durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rebonds sur les murs soignent 1 de plus, et les épines font saigner l'ennemi : 1.5 dégât par seconde pendant 2s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiques na parede curam 1 a mais, e toques espinhosos fazem o inimigo sangrar: 1.5 de dano por segundo por 2s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricoșeurile din pereți vindecă cu 1 mai mult, iar atingerile spinoase fac inamicul să sângereze: 1.5 daune pe secundă timp de 2s."
          }
        }
      }
    },
