    "Covered in thorny moss that scratches on touch. Every wall bounce mends a little health, so it wins the long game.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dornigem Moos bedeckt, das bei Berührung kratzt. Jeder Wandabpraller heilt ein bisschen – so gewinnt er auf lange Sicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubierto de musgo espinoso que araña al tocar. Cada rebote en pared recupera un poco de salud, así que gana a la larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvert de mousse épineuse qui griffe au contact. Chaque rebond sur un mur lui rend un peu de PV : il gagne sur la durée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coberto de musgo espinhoso que arranha ao toque. Cada quique na parede recupera um pouco de vida, então vence no cansaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoperit de mușchi spinos care zgârie la atingere. Fiecare ricoșeu din perete îi reface puțin HP, așa că învinge pe termen lung."
          }
        }
      }
    },
