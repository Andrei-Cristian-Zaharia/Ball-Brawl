    "Moves hit 6 harder. Every 4s, flicks a pawn at the enemy (4 damage).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Züge treffen 6 härter. Alle 4s schnippt er einen Bauern auf den Gegner (4 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las jugadas golpean 6 más fuerte. Cada 4s, lanza un peón al enemigo (4 de daño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les coups frappent 6 plus fort. Toutes les 4s, lance un pion sur l'ennemi (4 dégâts)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "駒のダメージ+6。4秒ごとに敵へポーンを弾き飛ばす（4ダメージ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수 피해 +6. 4초마다 적에게 폰을 튕겨요(4 피해)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lances acertam 6 a mais. A cada 4s, lança um peão no inimigo (4 de dano)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mutările lovesc cu 6 mai tare. La fiecare 4s aruncă un pion în inamic (4 daune)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走子伤害 +6。每 4 秒向敌人弹出一枚兵（4 点伤害）。"
          }
        }
      }
    },
