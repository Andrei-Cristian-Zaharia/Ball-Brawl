    "Pick a fighter, lock in, and watch them battle!": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Kämpfer, bestätige und sieh zu, wie er kämpft!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Elige un luchador, confirma y mira la batalla!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis un combattant, valide et regarde-le se battre !"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um lutador, confirme e veja a batalha!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege un luptător, confirmă și privește-l cum luptă!"
          }
        }
      }
    },
    "Pick your balls, aim the launch and watch them brawl. Climb the arenas, beat the daily Crusade and battle friends online.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deine Bälle, ziele beim Start und sieh zu, wie sie kämpfen. Erklimm die Arenen, meistere den täglichen Kreuzzug und kämpf online gegen Freunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tus bolas, apunta el lanzamiento y míralas pelear. Sube de arena, supera la Cruzada diaria y lucha con amigos en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis tes balles, vise le lancer et regarde-les se battre. Grimpe les arènes, termine la Croisade du jour et affronte tes amis en ligne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha suas bolas, mire o lançamento e veja a briga. Suba nas arenas, vença a Cruzada diária e enfrente amigos online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege-ți bilele, țintește lansarea și privește-le cum se bat. Urcă prin arene, bate Cruciada zilnică și luptă online cu prietenii."
          }
        }
      }
    },
    "Pickpocket throws one more knife. Every 5s, drops a mine behind it (5 damage).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Taschendiebstahl wirft ein Messer mehr. Alle 5s lässt er eine Mine hinter sich fallen (5 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El robo lanza un cuchillo más. Cada 5s, suelta una mina detrás (5 de daño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vol à la tire lance un couteau de plus. Toutes les 5s, lâche une mine derrière lui (5 dégâts)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O furto joga uma faca a mais. A cada 5s, solta uma mina atrás de si (5 de dano)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Furtul din buzunar aruncă încă un cuțit. La fiecare 5s lasă o mină în urmă (5 daune)."
          }
        }
      }
    },
    "Pieces": {
      "extractionState": "manual",
      "localizations": {
        "de": {
