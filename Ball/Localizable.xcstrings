    "Your fallen balls rest until the crusade resets tonight. Send a fresh team, or upgrade in the Collection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gefallenen Bälle ruhen, bis der Kreuzzug heute Nacht zurückgesetzt wird. Schick ein frisches Team oder verbessere in der Sammlung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus bolas caídas descansan hasta que la Cruzada se reinicie esta noche. Envía un equipo nuevo o mejora en la Colección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes balles tombées se reposent jusqu'à la réinitialisation de la Croisade ce soir. Envoie une équipe fraîche, ou améliore-les dans la Collection."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas bolas caídas descansam até a Cruzada reiniciar à noite. Mande um time novo ou melhore na Coleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilele căzute se odihnesc până se resetează cruciada diseară. Trimite o echipă proaspătă sau îmbunătățește-le în Colecție."
          }
        }
      }
    },
    "Your fighter was knocked out. Send in one of your remaining fighters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kämpfer wurde ausgeknockt. Schick einen deiner übrigen Kämpfer rein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noquearon a tu luchador. Envía a uno de los que te quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton combattant est K.O. Envoie un de tes combattants restants."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu lutador foi nocauteado. Mande um dos lutadores restantes."
          }
        },
        "ro": {
