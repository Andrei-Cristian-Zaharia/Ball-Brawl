    "%@ didn't answer in time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat nicht rechtzeitig geantwortet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no respondió a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'a pas répondu à temps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から時間内に応答がありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 제시간에 응답하지 않았어요."
          }
