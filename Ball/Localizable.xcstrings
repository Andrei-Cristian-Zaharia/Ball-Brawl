    "Traps hold 0.3s longer. Every 4.5s, throws a chain at the enemy (4 damage) that holds it for 0.3s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fallen halten 0,3s länger. Alle 4.5s wirft er eine Kette auf den Gegner (4 Schaden), die ihn 0,3s festhält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las trampas sujetan 0.3s más. Cada 4.5s, lanza una cadena al enemigo (4 de daño) que lo sujeta durante 0.3s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièges tiennent 0.3s de plus. Toutes les 4.5s, lance une chaîne sur l'ennemi (4 dégâts) qui le retient 0.3s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "罠の拘束時間+0.3秒。4.5秒ごとに敵へ鎖を投げ（4ダメージ）、0.3秒拘束。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함정이 0.3초 더 붙잡아요. 4.5초마다 적에게 사슬을 던져(4 피해) 0.3초 동안 붙잡아요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Armadilhas prendem 0.3s a mais. A cada 4.5s, joga uma corrente no inimigo (4 de dano) que o prende por 0.3s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Capcanele țin cu 0.3s mai mult. La fiecare 4.5s aruncă un lanț spre inamic (4 daune) care îl ține 0.3s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陷阱定身时间延长 0.3 秒。每 4.5 秒向敌人甩出锁链（4 点伤害），将其定身 0.3 秒。"
          }
        }
      }
    },
