    "Releases a circular shockwave every 2.5s that damages and knocks back a nearby opponent.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet alle 2.5s eine runde Schockwelle aus, die einen nahen Gegner verletzt und zurückstößt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza una onda expansiva circular cada 2.5s que daña y empuja al rival cercano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère une onde de choc circulaire toutes les 2.5s qui blesse et repousse un adversaire proche."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solta uma onda de choque circular a cada 2.5s que causa dano e empurra um oponente próximo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliberează o undă de șoc circulară la fiecare 2.5s care rănește și respinge un adversar din apropiere."
          }
        }
      }
    },
    "Releases homing bees that chase the enemy and poison it on sting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt zielsuchende Bienen los, die den Gegner jagen und beim Stich vergiften."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta abejas teledirigidas que persiguen al enemigo y lo envenenan al picar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère des abeilles à tête chercheuse qui poursuivent l'ennemi et l'empoisonnent en le piquant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solta abelhas teleguiadas que perseguem o inimigo e o envenenam ao picar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliberează albine cu autoghidare care urmăresc inamicul și îl otrăvesc când îl înțeapă."
          }
        }
      }
    },
