    "Freezes last 0.3s longer, and frozen enemies take 15% more damage from everything.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einfrieren hält 0,3s länger, und gefrorene Gegner nehmen 15% mehr Schaden von allem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las congelaciones duran 0.3s más y los enemigos congelados reciben un 15% más de daño de todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les gels durent 0.3s de plus, et les ennemis gelés subissent 15% de dégâts en plus de toutes les sources."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フリーズ時間+0.3秒。凍った敵が受けるダメージが15%アップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빙결이 0.3초 더 지속되고, 얼어붙은 적이 받는 모든 피해가 15% 늘어나요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Congelamentos duram 0.3s a mais, e inimigos congelados levam 15% a mais de dano de tudo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înghețările durează cu 0.3s mai mult, iar inamicii înghețați primesc cu 15% mai multe daune din orice sursă."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冰冻持续时间延长 0.3 秒，被冰冻的敌人受到的所有伤害提升 15%。"
          }
        }
      }
    },
