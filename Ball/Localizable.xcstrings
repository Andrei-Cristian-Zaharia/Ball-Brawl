    "Infects 0.15s sooner and poison lasts 1.5s longer; poisoned enemies deal 15% less damage.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Infiziert 0,15s früher und Gift hält 1,5s länger; vergiftete Gegner machen 15% weniger Schaden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Infecta 0.15s antes y el veneno dura 1.5s más; los enemigos envenenados causan un 15% menos de daño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Infecte 0.15s plus tôt et le poison dure 1.5s de plus ; les ennemis empoisonnés infligent 15% de dégâts en moins."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Infecta 0.15s antes e o veneno dura 1.5s a mais; inimigos envenenados causam 15% menos dano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Infectează cu 0.15s mai devreme și otrava durează cu 1.5s mai mult; inamicii otrăviți dau cu 15% mai puține daune."
          }
        }
      }
    },
