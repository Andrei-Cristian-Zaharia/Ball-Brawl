    "Win ranked battles for trophies. Every arena adds new balls to your chests.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinne Ranked-Kämpfe für Trophäen. Jede Arena bringt neue Bälle in deine Truhen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana batallas clasificatorias para conseguir trofeos. Cada arena añade bolas nuevas a tus cofres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne des combats classés pour des trophées. Chaque arène ajoute de nouvelles balles à tes coffres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vença batalhas ranqueadas para ganhar troféus. Cada arena adiciona novas bolas aos seus baús."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câștigă lupte competitive pentru trofee. Fiecare arenă adaugă bile noi în cuferele tale."
          }
        }
      }
    },
    "Win ranked battles, crusade bosses and VS Bot series to earn chests.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewinne Ranked-Kämpfe, Kreuzzug-Bosse und VS-Bot-Serien, um Truhen zu verdienen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gana batallas clasificatorias, jefes de Cruzada y series VS Bot para conseguir cofres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagne des combats classés, des boss de Croisade et des séries contre le bot pour gagner des coffres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vença batalhas ranqueadas, chefes da Cruzada e séries VS Bot para ganhar baús."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
