      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlängler"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reptante"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rampeur"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rastejador"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Târâtor"
          }
        }
      }
    },
    "Slithers faster than other balls and grows a longer, thicker tail over time. The tail hurts and knocks back the enemy on contact.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlängelt schneller als andere Bälle und bekommt mit der Zeit einen längeren, dickeren Schwanz. Der Schwanz verletzt den Gegner bei Kontakt und stößt ihn zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repta más rápido que otras bolas y le crece una cola más larga y gruesa con el tiempo. La cola daña y empuja al enemigo al tocarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rampe plus vite que les autres balles et sa queue devient plus longue et plus épaisse avec le temps. La queue blesse et repousse l'ennemi au contact."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rasteja mais rápido que as outras bolas e ganha uma cauda mais longa e grossa com o tempo. A cauda fere e empurra o inimigo ao tocar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se târăște mai repede decât celelalte bile și își crește în timp o coadă mai lungă și mai groasă. Coada rănește și respinge inamicul la contact."
          }
        }
      }
    },
