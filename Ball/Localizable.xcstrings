        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 › Game Centerで、Ball Brawlにフレンドの表示を許可すると、ここから招待できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구를 여기로 초대하려면 설정 › Game Center에서 Ball Brawl이 친구를 볼 수 있도록 허용해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
