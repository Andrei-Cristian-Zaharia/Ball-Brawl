          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 5s, una bengala teledirigida lenta (3 de daño) que ralentiza al enemigo un 25% durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 5s, une fusée lente à tête chercheuse (3 dégâts) qui ralentit l'ennemi de 25% pendant 2s."
          }
