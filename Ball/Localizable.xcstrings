    "Grabs a nearby opponent, spins it around and hurls it. Deals damage when the opponent smashes into a wall.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Packt einen nahen Gegner, wirbelt ihn herum und schleudert ihn. Verursacht Schaden, wenn der Gegner gegen eine Wand kracht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agarra a un rival cercano, lo hace girar y lo lanza. Causa daño cuando el rival choca contra una pared."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attrape un adversaire proche, le fait tourner et le projette. Inflige des dégâts quand l'adversaire s'écrase contre un mur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agarra um oponente próximo, gira e arremessa. Causa dano quando o oponente bate numa parede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apucă un adversar din apropiere, îl învârte și îl aruncă. Dă daune când adversarul se izbește de un perete."
          }
        }
      }
    },
