    "You're not signed in to Game Center. Open Settings › Game Center and sign in, then come back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht bei Game Center angemeldet. Öffne Einstellungen › Game Center, melde dich an und komm zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión en Game Center. Abre Ajustes › Game Center, inicia sesión y vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n'es pas connecté à Game Center. Ouvre Réglages › Game Center, connecte-toi, puis reviens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Centerにサインインしていません。設定 › Game Centerでサインインしてから戻ってきてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center에 로그인되어 있지 않아요. 설정 › Game Center를 열어 로그인한 후 돌아와 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está conectado ao Game Center. Abra Ajustes › Game Center, entre e volte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu ești conectat la Game Center. Deschide Configurări › Game Center, conectează-te, apoi revino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你尚未登录 Game Center。请打开「设置 › Game Center」登录后再回来。"
          }
        }
      }
    },
    "You've already used this code.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Code hast du schon benutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya usaste este código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as déjà utilisé ce code."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードはすでに使用済みです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 사용한 코드예요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já usou este código."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai folosit deja codul ăsta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已使用过该兑换码。"
          }
        }
      }
    },
    "You've used today's revive. Fallen balls return when the crusade resets.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutige Wiederbelebung verbraucht. Gefallene Bälle kehren beim Kreuzzug-Reset zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya usaste la reanimación de hoy. Las bolas caídas vuelven cuando la Cruzada se reinicie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as utilisé la réanimation du jour. Les balles tombées reviennent à la réinitialisation de la Croisade."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の復活は使用済みです。倒れたボールはクルセードのリセット時に戻ってきます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 부활을 이미 사용했어요. 쓰러진 볼은 원정이 초기화되면 돌아와요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já usou o reviver de hoje. Bolas caídas voltam quando a Cruzada reiniciar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai folosit reînvierea de azi. Bilele căzute revin când se resetează cruciada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的复活次数已用完。倒下的球将在远征重置时归队。"
          }
        }
      }
    },
    "You were away too long and left the battle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst zu lange weg und hast den Kampf verlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste ausente demasiado tiempo y abandonaste la batalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Absence trop longue : tu as quitté le combat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "離席時間が長すぎたため、バトルから退出しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 오래 자리를 비워서 배틀에서 나갔어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ficou ausente por muito tempo e saiu da batalha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai lipsit prea mult și ai părăsit lupta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你离开太久，已退出战斗。"
          }
        }
      }
    },
    "Your connection dropped, so the ranked battle counts as a loss.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Verbindung ist abgebrochen, daher zählt der Ranglistenkampf als Niederlage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cortó tu conexión, así que la batalla clasificatoria cuenta como derrota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta connexion a été coupée : le combat classé compte comme une défaite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が切れたため、このランク戦は負けになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 끊어져 랭크전은 패배로 처리돼요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conexão caiu, então a batalha ranqueada conta como derrota."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexiunea ta s-a întrerupt, așa că lupta clasată se consideră pierdută."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的连接已断开，本场排位战判负。"
          }
        }
      }
    },
    "Your %@ survived with %lld HP. Keep it in, or swap in a teammate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein %@ hat mit %lld HP überlebt. Lass ihn drin oder wechsle ein Teammitglied ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu %@ sobrevivió con %lld HP. Mantenlo o cámbialo por otro compañero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton %@ a survécu avec %lld PV. Garde-le ou fais entrer un coéquipier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がHP %lldで生き残りました。そのまま続けるか、仲間と交代しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 볼이 HP %lld로 살아남았어요. 계속 내보내거나 팀원과 교체하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu %@ sobreviveu com %lld HP. Mantenha ou troque por um aliado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a supraviețuit cu %lld HP. Păstreaz-o sau bagă un coechipier."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 %@ 以 %lld HP 存活。可以让它留场，或换上一名队友。"
          }
        }
      }
    },
