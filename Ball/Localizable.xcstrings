          "stringUnit": {
            "state": "translated",
            "value": "Besiege den Boss von %@, um diese Karte freizuschalten!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Vence al jefe de %@ para abrir este mapa!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bats le boss de %@ pour ouvrir cette carte !"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のボスを倒してこのマップを解放しよう！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 보스를 물리치면 이 지도가 열려요!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Derrote o chefe de %@ para liberar este mapa!"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Învinge boss-ul din %@ ca să deblochezi harta asta!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击败%@的 BOSS 即可开启此地图！"
          }
        }
      }
    },
