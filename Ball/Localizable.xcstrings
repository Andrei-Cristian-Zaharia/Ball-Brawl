    "Couldn't reach Game Center. Check your internet connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center nicht erreichbar. Prüfe deine Internetverbindung und versuch's nochmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Game Center. Revisa tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre Game Center. Vérifie ta connexion Internet et réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Centerに接続できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center에 연결할 수 없어요. 인터넷 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o Game Center. Verifique sua internet e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu am putut contacta Game Center. Verifică-ți conexiunea la internet și încearcă din nou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 Game Center。请检查网络连接后重试。"
          }
        }
      }
    },
    "Covered in thorny moss that scratches on touch. Every wall bounce mends a little health, so it wins the long game.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dornigem Moos bedeckt, das bei Berührung kratzt. Jeder Wandabpraller heilt ein bisschen – so gewinnt er auf lange Sicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubierto de musgo espinoso que araña al tocar. Cada rebote en pared recupera un poco de salud, así que gana a la larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvert de mousse épineuse qui griffe au contact. Chaque rebond sur un mur lui rend un peu de PV : il gagne sur la durée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触れるとひっかくトゲトゲの苔に覆われている。壁にバウンドするたびに少し回復するので、長期戦に強い。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닿으면 긁히는 가시 이끼로 덮여 있어요. 벽에 튕길 때마다 체력이 조금씩 회복돼서 장기전에 강해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coberto de musgo espinhoso que arranha ao toque. Cada quique na parede recupera um pouco de vida, então vence no cansaço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acoperit de mușchi spinos care zgârie la atingere. Fiecare ricoșeu din perete îi reface puțin HP, așa că învinge pe termen lung."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浑身覆盖带刺的苔藓，碰到就会被划伤。每次撞墙都会回复少量生命，越打越有优势。"
          }
        }
      }
    },
    "Crash": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Absturz"
          }
