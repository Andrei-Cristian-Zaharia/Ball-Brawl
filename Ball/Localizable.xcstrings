    "Bursts leave ice on the floor for 2.5s. Standing on it chills the enemy toward a freeze.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Explosionen hinterlassen 2,5s lang Eis am Boden. Wer darauf steht, kühlt bis zum Einfrieren ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estallidos dejan hielo en el suelo durante 2.5s. Pisarlo enfría al enemigo hasta congelarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éclats laissent de la glace au sol pendant 2.5s. Rester dessus refroidit l'ennemi jusqu'au gel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explosões deixam gelo no chão por 2.5s. Ficar nele esfria o inimigo até congelar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exploziile lasă gheață pe jos timp de 2.5s. Cât stă pe ea, inamicul se răcește până îngheață."
          }
        }
      }
    },
