    "Hitting a wall lays a track across the arena. Moments later a train thunders down it and rams anything in the way.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Wandtreffer legt ein Gleis durch die Arena. Kurz danach donnert ein Zug darüber und rammt alles im Weg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al chocar con una pared tiende una vía por la arena. Instantes después, un tren pasa a toda máquina y arrolla todo lo que encuentra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher un mur pose une voie à travers l'arène. Peu après, un train y fonce et percute tout sur son passage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bater numa parede cria um trilho pela arena. Logo depois um trem passa trovejando e atropela tudo no caminho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Când lovește un perete, pune o șină prin arenă. O clipă mai târziu, un tren gonește pe ea și izbește tot ce-i iese în cale."
          }
        }
      }
    },
