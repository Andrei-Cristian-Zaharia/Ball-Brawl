    "Game Center doesn't recognise this app yet. Game Center must be enabled for it in App Store Connect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center erkennt diese App noch nicht. Game Center muss in App Store Connect dafür aktiviert sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center aún no reconoce esta app. Debe activarse Game Center para ella en App Store Connect."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ne reconnaît pas encore cette app. Game Center doit être activé pour elle dans App Store Connect."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Centerがまだこのアプリを認識していません。App Store ConnectでGame Centerを有効にする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center가 아직 이 앱을 인식하지 못해요. App Store Connect에서 이 앱의 Game Center를 활성화해야 해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center ainda não reconhece este app. Ele precisa ser ativado no App Store Connect."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center nu recunoaște încă aplicația. Game Center trebuie activat pentru ea în App Store Connect."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 尚未识别此 App。需要在 App Store Connect 中为其启用 Game Center。"
          }
        }
      }
    },
    "Game Center is blocked by Screen Time or parental controls on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ist auf diesem Gerät durch Bildschirmzeit oder Kindersicherung gesperrt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center está bloqueado por Tiempo en pantalla o el control parental en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center est bloqué par Temps d'écran ou le contrôle parental sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではスクリーンタイムまたはペアレンタルコントロールによりGame Centerが制限されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 스크린 타임 또는 자녀 보호 기능으로 Game Center가 차단돼 있어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center está bloqueado pelo Tempo de Uso ou controle parental neste aparelho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center e blocat de Timp de utilizare sau de controlul parental pe acest dispozitiv."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的 Game Center 已被屏幕使用时间或家长控制阻止。"
          }
        }
      }
    },
    "Game Center isn't available on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center ist auf diesem Gerät nicht verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center no está disponible en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center n'est pas disponible sur cet appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではGame Centerを利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 Game Center를 사용할 수 없어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Game Center não está disponível neste aparelho."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center nu e disponibil pe acest dispozitiv."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备无法使用 Game Center。"
          }
        }
      }
    },
    "Game Center sign-in failed. Check Settings › Game Center and try again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game-Center-Anmeldung fehlgeschlagen. Prüfe Einstellungen › Game Center und versuch's nochmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló el inicio de sesión de Game Center. Revisa Ajustes › Game Center e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion à Game Center. Vérifie Réglages › Game Center et réessaie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Centerへのサインインに失敗しました。設定 › Game Centerを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 로그인에 실패했어요. 설정 › Game Center를 확인하고 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha no login do Game Center. Verifique Ajustes › Game Center e tente de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea la Game Center a eșuat. Verifică Configurări › Game Center și încearcă din nou."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 登录失败。请检查「设置 › Game Center」后重试。"
          }
        }
      }
    },
    "Game Center sign-in was closed. Open Settings › Game Center and sign in, then come back.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Game-Center-Anmeldung geschlossen. Öffne Einstellungen › Game Center, melde dich an und komm zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerró el inicio de sesión de Game Center. Abre Ajustes › Game Center, inicia sesión y vuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion à Game Center a été fermée. Ouvre Réglages › Game Center, connecte-toi, puis reviens."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Centerのサインインが閉じられました。設定 › Game Centerでサインインしてから戻ってきてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 로그인이 닫혔어요. 설정 › Game Center를 열어 로그인한 후 돌아와 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login no Game Center foi fechado. Abra Ajustes › Game Center, entre e volte."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectarea la Game Center a fost închisă. Deschide Configurări › Game Center, conectează-te, apoi revino."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Game Center 登录已关闭。请打开「设置 › Game Center」登录后再回来。"
          }
        }
      }
    },
