    "Charges from damage. Splits right away without being knocked out: one small cell per growth stage, plus one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Teilt sich sofort, ohne ausgeknockt zu werden: eine kleine Zelle pro Wachstumsstufe, plus eine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Se divide al instante sin ser derrotado: una célula pequeña por etapa de crecimiento, más una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Se divise aussitôt sans être K.O. : une petite cellule par stade de croissance, plus une."
          }
        },
        "ja": {
