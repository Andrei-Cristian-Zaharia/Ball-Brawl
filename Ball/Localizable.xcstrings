    "Bites hit 1 harder. Every 4s, leaves a sticky blob that slows the enemy by 30% for 3s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisse treffen 1 härter. Alle 4s hinterlässt er einen Klebeklecks, der den Gegner 3s lang um 30% verlangsamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mordiscos golpean 1 más fuerte. Cada 4s, deja una mancha pegajosa que ralentiza al enemigo un 30% durante 3s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morsures frappent 1 plus fort. Toutes les 4s, laisse une flaque collante qui ralentit l'ennemi de 30% pendant 3s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mordidas acertam 1 mais forte. A cada 4s, solta uma gosma que deixa o inimigo 30% mais lento por 3s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mușcăturile lovesc cu 1 mai tare. La fiecare 4s lasă o pată lipicioasă care încetinește inamicul cu 30% timp de 3s."
          }
        }
      }
    },
    "Bites hit 1 harder. Every 5s the twins swap places, dodging out of trouble.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisse treffen 1 härter. Alle 5s tauschen die Zwillinge die Plätze und weichen so Ärger aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mordiscos golpean 1 más fuerte. Cada 5s los gemelos se cambian de sitio y esquivan el peligro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morsures frappent 1 plus fort. Toutes les 5s, les jumeaux échangent leurs places pour esquiver le danger."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mordidas acertam 1 mais forte. A cada 5s os gêmeos trocam de lugar e escapam do perigo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mușcăturile lovesc cu 1 mai tare. La fiecare 5s gemenii își schimbă locurile și scapă de pericol."
          }
        }
      }
    },
    "Bites hit 3 harder. Every 6s, howls for a burst of speed: 35% faster for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisse treffen 3 härter. Alle 6s heult er für einen Tempo-Schub: 2s lang 35% schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mordiscos golpean 3 más fuerte. Cada 6s, aúlla para acelerar: un 35% más rápido durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morsures frappent 3 plus fort. Toutes les 6s, hurle pour un sprint : 35% plus rapide pendant 2s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mordidas acertam 3 mais forte. A cada 6s, uiva e ganha velocidade: 35% mais rápido por 2s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mușcăturile lovesc cu 3 mai tare. La fiecare 6s urlă și accelerează: cu 35% mai rapid timp de 2s."
          }
        }
      }
    },
    "Bites make the enemy bleed: 2 damage per second for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisse verursachen Blutung: 2 Schaden pro Sekunde für 2s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mordiscos hacen sangrar al enemigo: 2 de daño por segundo durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les morsures font saigner l'ennemi : 2 dégâts par seconde pendant 2s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mordidas fazem o inimigo sangrar: 2 de dano por segundo por 2s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mușcăturile fac inamicul să sângereze: 2 daune pe secundă timp de 2s."
          }
        }
      }
    },
    "Bites on contact. The weaker the enemy gets, the harder it bites (up to 80% harder) and the faster it runs.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beißt bei Berührung. Je schwächer der Gegner, desto härter beißt er (bis zu 80% härter) und desto schneller rennt er."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muerde al contacto. Cuanto más débil está el enemigo, más fuerte muerde (hasta un 80% más) y más rápido corre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mord au contact. Plus l'ennemi faiblit, plus il mord fort (jusqu'à 80% plus fort) et plus il court vite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Morde ao encostar. Quanto mais fraco o inimigo, mais forte morde (até 80%) e mais rápido corre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Mușcă la contact. Cu cât inamicul e mai slăbit, cu atât mușcă mai tare (până la 80% mai tare) și aleargă mai repede."
          }
        }
      }
    },
    "Blasts hit 6 harder and throw 3 mini-bombs (5 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Explosionen treffen 6 härter und werfen 3 Mini-Bomben (je 5 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las explosiones golpean 6 más fuerte y lanzan 3 minibombas (5 de daño cada una)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les explosions frappent 6 plus fort et projettent 3 mini-bombes (5 dégâts chacune)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explosões acertam 6 a mais e lançam 3 minibombas (5 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Exploziile lovesc cu 6 mai tare și aruncă 3 mini-bombe (5 daune fiecare)."
          }
        }
      }
    },
    "Bleed": {
      "extractionState": "manual",
      "localizations": {
