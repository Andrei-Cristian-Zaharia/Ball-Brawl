    "A die that hits on a 6 throws a bonus die.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Würfel, der mit einer 6 trifft, wirft einen Bonuswürfel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dado que acierta con un 6 lanza un dado extra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dé qui touche sur un 6 lance un dé bonus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dado que acerta com 6 joga um dado bônus."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un zar care lovește cu 6 aruncă un zar bonus."
          }
        }
      }
    },
    "A moon slowly slides across its face. Just before full eclipse it stalls for a random, tense moment — then totality strikes the enemy wherever they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Mond schiebt sich langsam über sein Gesicht. Kurz vor der totalen Finsternis stockt er für einen zufälligen, spannenden Moment – dann trifft die Totalität den Gegner, wo er auch ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una luna se desliza lentamente por su cara. Justo antes del eclipse total se detiene un instante aleatorio y tenso; entonces la totalidad golpea al enemigo esté donde esté."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une lune glisse lentement sur sa face. Juste avant l'éclipse totale, elle s'arrête un instant au hasard, plein de suspense — puis la totalité frappe l'ennemi où qu'il soit."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma lua desliza devagar pela sua face. Pouco antes do eclipse total ela trava por um instante aleatório e tenso — e a totalidade atinge o inimigo onde ele estiver."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O lună alunecă încet peste fața lui. Chiar înainte de eclipsa totală se oprește un moment aleatoriu, plin de suspans — apoi totalitatea lovește inamicul oriunde ar fi."
          }
        }
      }
    },
    "A move that hits stuns the enemy for 0.4s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein treffender Zug betäubt den Gegner 0,4s lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una jugada que acierta aturde al enemigo durante 0.4s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un coup qui touche étourdit l'ennemi pendant 0.4s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lance que acerta atordoa o inimigo por 0.4s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O mutare care nimerește amețește inamicul 0.4s."
          }
        }
      }
    },
