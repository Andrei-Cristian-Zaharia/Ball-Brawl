    },
    "The streak never drops below 5. Every 5s, throws a spiral of 3 homing numbers (2 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serie fällt nie unter 5. Alle 5s wirft er eine Spirale aus 3 zielsuchenden Zahlen (je 2 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La racha nunca baja de 5. Cada 5s, lanza una espiral de 3 números teledirigidos (2 de daño cada uno)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La série ne descend jamais sous 5. Toutes les 5s, lance une spirale de 3 nombres à tête chercheuse (2 dégâts chacun)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sequência nunca cai abaixo de 5. A cada 5s, lança uma espiral de 3 números teleguiados (2 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seria nu scade niciodată sub 5. La fiecare 5s aruncă o spirală de 3 numere cu autoghidare (2 daune fiecare)."
          }
        }
      }
    },
    "The streak starts one number higher (at 3), and bolts fire 5% faster.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Serie startet eine Zahl höher (bei 3), und Bolzen feuern 5% schneller."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La racha empieza un número más alto (en 3) y los rayos salen un 5% más rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La série commence un nombre plus haut (à 3), et les projectiles partent 5% plus vite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sequência começa um número acima (no 3), e os projéteis saem 5% mais rápido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Seria începe cu un număr mai sus (la 3), iar proiectilele se trag cu 5% mai repede."
          }
        }
      }
    },
