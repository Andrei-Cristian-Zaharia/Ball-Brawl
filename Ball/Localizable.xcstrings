        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피해로 충전돼요. 적의 경로를 따라 폭탄 5개를 일렬로 떨어뜨려요(각 8 피해)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
