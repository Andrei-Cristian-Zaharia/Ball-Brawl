    "Pick a ball for Preset %lld, slot %lld": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ball für Preset %lld, Platz %lld"
          }
        },
        "es": {
