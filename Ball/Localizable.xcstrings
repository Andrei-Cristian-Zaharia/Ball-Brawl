          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Razele ard: 2 daune pe secundă timp de 2s."
          }
        }
      }
    },
    "Beat the Normal boss of %@ today to open Hard!": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besiege heute den Normal-Boss von %@, um Schwer freizuschalten!"
          }
        },
        "es": {
