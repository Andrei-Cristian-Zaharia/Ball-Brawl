    "Tail grows faster, and its hits poison: 3 damage per second for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwanz wächst schneller, und seine Treffer vergiften: 3 Schaden pro Sekunde für 2s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola crece más rápido y sus golpes envenenan: 3 de daño por segundo durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La queue pousse plus vite, et ses coups empoisonnent : 3 dégâts par seconde pendant 2s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cauda cresce mais rápido, e seus golpes envenenam: 3 de dano por segundo por 2s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coada crește mai repede, iar loviturile ei otrăvesc: 3 daune pe secundă timp de 2s."
          }
        }
      }
    },
    "Tail hits 4 harder. Once per fight, below 40% health, sheds a quarter of its tail for a 2.5s burst of speed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schwanz trifft 4 härter. Einmal pro Kampf, unter 40% HP, wirft er ein Viertel seines Schwanzes ab für 2,5s Tempoboost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cola golpea 4 más fuerte. Una vez por pelea, por debajo del 40% de salud, suelta un cuarto de su cola para ganar 2.5s de velocidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La queue frappe 4 plus fort. Une fois par combat, sous 40% de PV, perd un quart de sa queue pour un sprint de 2.5s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cauda acerta 4 mais forte. Uma vez por luta, abaixo de 40% de vida, solta um quarto da cauda para 2.5s de velocidade."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Coada lovește cu 4 mai tare. O dată pe luptă, sub 40% HP, își leapădă un sfert din coadă pentru 2.5s de viteză."
          }
        }
      }
    },
