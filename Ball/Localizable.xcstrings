        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 배틀을 떠났어요. 승리! 트로피 +%lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ saiu da batalha. Você venceu! +%lld troféus"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a părăsit lupta. Ai câștigat! +%lld trofee"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 离开了战斗。你赢了！+%lld 奖杯"
          }
        }
