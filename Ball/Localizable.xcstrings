    "Every 3.5s, 4 homing spores (1 damage) that add poison.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 3.5s 4 zielsuchende Sporen (1 Schaden), die Gift hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 3.5s, 4 esporas teledirigidas (1 de daño) que añaden veneno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 3.5s, 4 spores à tête chercheuse (1 dégât) qui ajoutent du poison."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 3.5s, 4 esporos teleguiados (1 de dano) que somam veneno."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 3.5s, 4 spori cu autoghidare (1 daună) care adaugă otravă."
          }
        }
      }
    },
    "Every 3.5s, throws off a ring of 6 sparks (3 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
