    "Your fallen balls rest until the crusade resets tonight. Send a fresh team, or upgrade in the Collection.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gefallenen Bälle ruhen, bis der Kreuzzug heute Nacht zurückgesetzt wird. Schick ein frisches Team oder verbessere in der Sammlung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus bolas caídas descansan hasta que la Cruzada se reinicie esta noche. Envía un equipo nuevo o mejora en la Colección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes balles tombées se reposent jusqu'à la réinitialisation de la Croisade ce soir. Envoie une équipe fraîche, ou améliore-les dans la Collection."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "倒れたボールは今夜クルセードがリセットされるまで休憩中。新しいチームを送り込むか、コレクションで強化しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰러진 볼은 오늘 밤 원정이 초기화될 때까지 쉬어요. 새 팀을 보내거나 컬렉션에서 업그레이드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas bolas caídas descansam até a Cruzada reiniciar à noite. Mande um time novo ou melhore na Coleção."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilele căzute se odihnesc până se resetează cruciada diseară. Trimite o echipă proaspătă sau îmbunătățește-le în Colecție."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒下的球将休息到今晚远征重置。派出一支新队伍，或去收藏中升级。"
          }
        }
      }
    },
    "Your fighter was knocked out. Send in one of your remaining fighters.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Kämpfer wurde ausgeknockt. Schick einen deiner übrigen Kämpfer rein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Noquearon a tu luchador. Envía a uno de los que te quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton combattant est K.O. Envoie un de tes combattants restants."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイターが倒されました。残りのファイターから1体を送り出そう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파이터가 쓰러졌어요. 남은 파이터 중 하나를 보내세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu lutador foi nocauteado. Mande um dos lutadores restantes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luptătorul tău e K.O. Trimite unul dintre luptătorii rămași."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的斗士被击倒了。派出一名剩余的斗士上场。"
          }
        }
      }
    },
    "Your opponent has a different version of the game. Both players need the latest update.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gegner hat eine andere Spielversion. Beide brauchen das neueste Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu rival tiene otra versión del juego. Ambos jugadores necesitan la última actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton adversaire a une autre version du jeu. Les deux joueurs doivent avoir la dernière mise à jour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対戦相手のゲームのバージョンが違います。両プレイヤーとも最新版にアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대의 게임 버전이 달라요. 두 플레이어 모두 최신 업데이트가 필요해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu oponente tem outra versão do jogo. Os dois precisam da atualização mais recente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adversarul tău are altă versiune a jocului. Ambii jucători au nevoie de ultima actualizare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对手的游戏版本与你不同。双方都需要更新到最新版本。"
          }
        }
      }
    },
