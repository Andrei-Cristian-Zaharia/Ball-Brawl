    "Damages the opponent on every collision — the faster it rams in, the harder it hits. Short cooldown between hits.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verletzt den Gegner bei jedem Zusammenstoß – je schneller der Rammstoß, desto härter der Treffer. Kurze Abklingzeit zwischen Treffern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Daña al rival en cada choque: cuanto más rápido embiste, más fuerte golpea. Breve recarga entre golpes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blesse l'adversaire à chaque collision — plus la charge est rapide, plus ça fait mal. Court délai entre les coups."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Causa dano ao oponente em toda colisão — quanto mais rápido investe, mais forte acerta. Recarga curta entre acertos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rănește adversarul la fiecare coliziune — cu cât izbește mai repede, cu atât lovește mai tare. Pauză scurtă între lovituri."
          }
        }
      }
    },
