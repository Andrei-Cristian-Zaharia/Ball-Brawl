    "You've used today's revive. Fallen balls return when the crusade resets.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heutige Wiederbelebung verbraucht. Gefallene Bälle kehren beim Kreuzzug-Reset zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya usaste la reanimación de hoy. Las bolas caídas vuelven cuando la Cruzada se reinicie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as utilisé la réanimation du jour. Les balles tombées reviennent à la réinitialisation de la Croisade."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já usou o reviver de hoje. Bolas caídas voltam quando a Cruzada reiniciar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai folosit reînvierea de azi. Bilele căzute revin când se resetează cruciada."
          }
        }
      }
    },
    "You were away too long and left the battle.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du warst zu lange weg und hast den Kampf verlassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estuviste ausente demasiado tiempo y abandonaste la batalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
