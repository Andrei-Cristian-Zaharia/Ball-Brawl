    "Every 3.5s, 4 homing spores (1 damage) that add poison.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 3.5s 4 zielsuchende Sporen (1 Schaden), die Gift hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 3.5s, 4 esporas teledirigidas (1 de daño) que añaden veneno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 3.5s, 4 spores à tête chercheuse (1 dégât) qui ajoutent du poison."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3.5秒ごとに追尾する胞子を4つ放ち（1ダメージ）、毒を付与。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3.5초마다 독을 더하는 유도 포자 4개(1 피해)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 3.5s, 4 esporos teleguiados (1 de dano) que somam veneno."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 3.5s, 4 spori cu autoghidare (1 daună) care adaugă otravă."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 3.5 秒发射 4 颗追踪孢子（1 点伤害），附加中毒。"
          }
        }
      }
    },
    "Every 3.5s, throws off a ring of 6 sparks (3 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 3.5s wirft er einen Ring aus 6 Funken ab (je 3 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 3.5s, suelta un anillo de 6 chispas (3 de daño cada una)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 3.5s, projette un anneau de 6 étincelles (3 dégâts chacune)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3.5秒ごとに火花を6つリング状に放つ（各3ダメージ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3.5초마다 불꽃 6개를 고리 모양으로 뿜어요(각 3 피해)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 3.5s, solta um anel de 6 faíscas (3 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 3.5s aruncă un inel de 6 scântei (3 daune fiecare)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 3.5 秒甩出一圈 6 颗火花（每颗 3 点伤害）。"
          }
        }
      }
    },
    "Every 4s, 3 homing stars (1.5 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 4s 3 zielsuchende Sterne (je 1,5 Schaden)."
          }
