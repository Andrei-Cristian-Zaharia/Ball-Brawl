        }
      }
    },
    "One free revive a day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Gratis-Wiederbelebung pro Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una reanimación gratis al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réanimation gratuite par jour."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um reviver grátis por dia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O reînviere gratuită pe zi."
          }
        }
      }
    },
    "One more bee per swarm. Every 5s, drips a honey patch for 3s that slows the enemy by 40%.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Biene mehr pro Schwarm. Alle 5s tropft er 3s lang einen Honigfleck, der den Gegner um 40% verlangsamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una abeja más por enjambre. Cada 5s, deja un charco de miel durante 3s que ralentiza al enemigo un 40%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une abeille de plus par essaim. Toutes les 5s, laisse couler une flaque de miel pendant 3s qui ralentit l'ennemi de 40%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma abelha a mais por enxame. A cada 5s, pinga uma poça de mel por 3s que deixa o inimigo 40% mais lento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă o albină pe roi. La fiecare 5s picură o pată de miere timp de 3s care încetinește inamicul cu 40%."
          }
        }
      }
    },
    "One more thread at a time; threads slow the enemy by 35% for 1.5s when they snap on it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Faden mehr gleichzeitig; reißende Fäden verlangsamen den Gegner 1,5s lang um 35%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un hilo más a la vez; los hilos ralentizan al enemigo un 35% durante 1.5s al romperse sobre él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fil de plus à la fois ; les fils ralentissent l'ennemi de 35% pendant 1.5s quand ils se rompent sur lui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fio a mais por vez; fios deixam o inimigo 35% mais lento por 1.5s ao se romperem nele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă un fir în același timp; firele încetinesc inamicul cu 35% timp de 1.5s când se rup pe el."
          }
        }
      }
    },
    "One more trap, biting 4 harder; trapped enemies bleed 2 damage per second for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Falle mehr, die 4 härter beißt; gefangene Gegner bluten 2s lang 2 Schaden pro Sekunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una trampa más, que muerde 4 más fuerte; los enemigos atrapados sangran 2 de daño por segundo durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un piège de plus, qui mord 4 plus fort ; les ennemis piégés saignent 2 dégâts par seconde pendant 2s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma armadilha a mais, mordendo 4 mais forte; inimigos presos sangram 2 de dano por segundo por 2s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă o capcană, care mușcă cu 4 mai tare; inamicii prinși sângerează 2 daune pe secundă timp de 2s."
          }
        }
      }
    },
    "One time only: coins, chests and Spike cards": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur einmal: Münzen, Truhen und Spike-Karten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo una vez: monedas, cofres y cartas de Spike"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une seule fois : pièces, coffres et cartes Spike"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só uma vez: moedas, baús e cartas do Spike"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O singură dată: monede, cufere și cărți Spike"
          }
        }
      }
    },
    "Open %lld chests": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne %lld Truhen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre %lld cofres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre %lld coffres"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra %lld baús"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide %lld cufere"
          }
        }
      }
    },
    "Open portals sting the enemy nearby: 1 damage every second.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offene Portale stechen den Gegner in der Nähe: 1 Schaden pro Sekunde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los portales abiertos pican al enemigo cercano: 1 de daño cada segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les portails ouverts piquent l'ennemi proche : 1 dégât par seconde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Portais abertos ferroam o inimigo por perto: 1 de dano por segundo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portalurile deschise înțeapă inamicul din apropiere: 1 daună pe secundă."
          }
        }
      }
    },
    "Opens pairs of portals, one right in the enemy's path. Rolling into one throws it out of the other, hurt and flung toward a wall.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Portalpaare, eines direkt im Weg des Gegners. Rollt er hinein, fliegt er aus dem anderen – verletzt und Richtung Wand geschleudert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre pares de portales, uno justo en el camino del enemigo. Al entrar en uno sale por el otro, herido y lanzado contra una pared."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre des paires de portails, dont un pile sur le chemin de l'ennemi. S'il roule dedans, il ressort par l'autre, blessé et projeté vers un mur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre pares de portais, um bem no caminho do inimigo. Entrar num joga ele para fora do outro, ferido e arremessado contra uma parede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide perechi de portaluri, unul fix în calea inamicului. Dacă intră într-unul, iese pe celălalt, rănit și aruncat spre un perete."
          }
        }
      }
    },
