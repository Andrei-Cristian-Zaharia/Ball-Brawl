          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Congela al enemigo y cierra sobre él un anillo de 8 picos de hielo (2 de daño cada uno)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Gèle l'ennemi et referme sur lui un anneau de 8 pics de glace (2 dégâts chacun)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Congela o inimigo e fecha um anel de 8 espinhos de gelo nele (2 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Îngheață inamicul și strânge în jurul lui un inel de 8 țepi de gheață (2 daune fiecare)."
          }
        }
      }
    },
    "Charges from damage. Freezes the enemy for 1.8s and scatters 6 error tiles around it.": {
