    "Zones are 15 bigger, and enemies burning in them are slowed by 25%.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen sind 15 größer, und brennende Gegner darin werden um 25% verlangsamt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas son 15 más grandes y los enemigos que arden en ellas se ralentizan un 25%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones sont 15 plus grandes, et les ennemis qui y brûlent sont ralentis de 25%."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas 15 maiores, e inimigos queimando nelas ficam 25% mais lentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonele sunt mai mari cu 15, iar inamicii care ard în ele sunt încetiniți cu 25%."
          }
        }
      }
    },
    "Zones burn 4 more per second. Every 4s, a small heat wave around it (4 damage).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonen brennen 4 mehr pro Sekunde. Alle 4s eine kleine Hitzewelle um ihn (4 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las zonas queman 4 más por segundo. Cada 4s, una pequeña ola de calor a su alrededor (4 de daño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les zones brûlent 4 de plus par seconde. Toutes les 4s, une petite vague de chaleur autour de lui (4 dégâts)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonas queimam 4 a mais por segundo. A cada 4s, uma pequena onda de calor ao redor (4 de dano)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonele ard cu 4 mai mult pe secundă. La fiecare 4s, un mic val de căldură în jurul lui (4 daune)."
          }
        }
      }
    },
