    "This can't be undone. You'll start again from level 1 in the first arena.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann nicht rückgängig gemacht werden. Du startest wieder bei Level 1 in der ersten Arena."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Volverás a empezar desde el nivel 1 en la primera arena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est irréversible. Tu recommenceras au niveau 1 dans la première arène."
          }
        },
        "pt-BR": {
