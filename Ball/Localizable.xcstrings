    "%@ knocked out your whole team.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat dein ganzes Team ausgeknockt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ noqueó a todo tu equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a mis K.O. toute ton équipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にチーム全員を倒されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 내 팀을 전멸시켰어요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nocauteou seu time inteiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ți-a făcut K.O. toată echipa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 击倒了你的全队。"
          }
        }
      }
    },
    "%@ left the battle. You win! +%lld trophies": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Kampf verlassen. Du gewinnst! +%lld Trophäen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ abandonó la batalla. ¡Ganas! +%lld trofeos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a quitté le combat. Tu gagnes ! +%lld trophées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がバトルから退出。あなたの勝ち！トロフィー+%lld"
