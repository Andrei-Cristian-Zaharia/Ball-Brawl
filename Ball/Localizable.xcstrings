    "Gears hit 1 harder, and each rewind stuns the enemy for 0.35s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahnräder treffen 1 härter, und jedes Zurückspulen betäubt den Gegner 0,35s lang."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los engranajes golpean 1 más fuerte y cada rebobinado aturde al enemigo durante 0.35s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les engrenages frappent 1 plus fort, et chaque retour arrière étourdit l'ennemi pendant 0.35s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Engrenagens acertam 1 mais forte, e cada retrocesso atordoa o inimigo por 0.35s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Roțile dințate lovesc cu 1 mai tare, iar fiecare derulare amețește inamicul 0.35s."
          }
        }
      }
    },
