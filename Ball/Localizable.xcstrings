    "This is the name opponents see. 3–16 letters, numbers, spaces, _ - or .": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Namen sehen Gegner. 3–16 Buchstaben, Zahlen, Leerzeichen, _ - oder ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el nombre que ven tus rivales. De 3 a 16 letras, números, espacios, _ - o ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est le nom que voient tes adversaires. 3 à 16 lettres, chiffres, espaces, _ - ou ."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o nome que os oponentes veem. 3–16 letras, números, espaços, _ - ou ."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ăsta e numele pe care îl văd adversarii. 3–16 litere, cifre, spații, _ - sau ."
          }
        }
      }
    },
