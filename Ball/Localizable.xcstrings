        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Congela al enemigo durante 1.8s y esparce 6 casillas de error a su alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Fige l'ennemi pendant 1.8s et sème 6 cases d'erreur autour de lui."
