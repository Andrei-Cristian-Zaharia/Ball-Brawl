    "Pools last 0.4s longer, and burning slows the enemy by 25%.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfützen halten 0,4s länger, und Brennen verlangsamt den Gegner um 25%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los charcos duran 0.4s más y la quemadura ralentiza al enemigo un 25%."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les flaques durent 0.4s de plus, et la brûlure ralentit l'ennemi de 25%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "溶岩だまりが0.4秒長く残り、燃焼が敵を25%スロウ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웅덩이가 0.4초 더 지속되고, 불타는 적은 25% 느려져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poças duram 0.4s a mais, e queimar deixa o inimigo 25% mais lento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bălțile durează cu 0.4s mai mult, iar arsura încetinește inamicul cu 25%."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "熔岩池持续时间延长 0.4 秒，灼烧使敌人减速 25%。"
          }
        }
      }
    },
