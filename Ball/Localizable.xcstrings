    "Each charge adds 1 more damage, and shocks slow the enemy by 25% for 2.5s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Ladung macht 1 Schaden mehr, und Schocks verlangsamen den Gegner 2,5s lang um 25%."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada carga añade 1 de daño más y las descargas ralentizan al enemigo un 25% durante 2.5s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque charge ajoute 1 dégât, et les chocs ralentissent l'ennemi de 25% pendant 2.5s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada carga soma 1 de dano, e choques deixam o inimigo 25% mais lento por 2.5s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare încărcare adaugă 1 daună, iar șocurile încetinesc inamicul cu 25% timp de 2.5s."
          }
        }
      }
    },
    "Each sting heals it 1.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Stich heilt ihn um 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada picadura le cura 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque piqûre le soigne de 1."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada picada cura 1."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare înțepătură îl vindecă cu 1."
          }
        }
      }
    },
    "Each wall hit can mount a turret on the wall that keeps shooting the enemy. Up to 5; a new one replaces the oldest.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Wandtreffer kann ein Geschütz an die Wand setzen, das ständig auf den Gegner feuert. Bis zu 5; ein neues ersetzt das älteste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada golpe en pared puede montar una torreta que no deja de disparar al enemigo. Hasta 5; una nueva reemplaza a la más antigua."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque contact avec un mur peut y installer une tourelle qui tire sans cesse sur l'ennemi. Jusqu'à 5 ; une nouvelle remplace la plus ancienne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada batida na parede pode montar uma torreta que atira sem parar no inimigo. Até 5; uma nova substitui a mais antiga."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare lovitură în perete poate monta acolo o turelă care trage continuu în inamic. Maxim 5; una nouă o înlocuiește pe cea mai veche."
          }
        }
      }
    },
