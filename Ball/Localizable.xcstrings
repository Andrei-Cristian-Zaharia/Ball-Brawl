    "Totality burns the enemy: 2 damage per second for 3s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalität verbrennt den Gegner: 2 Schaden pro Sekunde für 3s."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La totalidad quema al enemigo: 2 de daño por segundo durante 3s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La totalité brûle l'ennemi : 2 dégâts par seconde pendant 3s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A totalidade queima o inimigo: 2 de dano por segundo por 3s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalitatea arde inamicul: 2 daune pe secundă timp de 3s."
          }
        }
      }
    },
    "Touch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
