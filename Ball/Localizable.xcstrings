          "stringUnit": {
            "state": "translated",
            "value": "同じ呪文を2回連続で唱えず、詠唱速度が10%アップ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 주문을 연속으로 두 번 쓰지 않고, 10% 더 빨리 시전해요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca lança o mesmo feitiço duas vezes seguidas, e lança 10% mais rápido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu aruncă niciodată aceeași vrajă de două ori la rând și aruncă cu 10% mai repede."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永远不会连续施放同一个法术，施法速度提升 10%。"
          }
        }
      }
    },
