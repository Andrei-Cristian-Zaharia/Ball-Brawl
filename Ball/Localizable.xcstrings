    "Leaves a trail of lava pools as it rolls, and touching it sets the enemy on fire. The enemy burns while standing in lava.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinterlässt beim Rollen eine Spur aus Lavapfützen, und seine Berührung setzt den Gegner in Brand. Der Gegner brennt, solange er in Lava steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja un rastro de charcos de lava al rodar, y tocarlo prende fuego al enemigo. El enemigo arde mientras pisa la lava."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse une traînée de flaques de lave en roulant, et le toucher enflamme l'ennemi. L'ennemi brûle tant qu'il reste dans la lave."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixa um rastro de poças de lava ao rolar, e tocá-lo põe fogo no inimigo. O inimigo queima enquanto estiver na lava."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasă o dâră de bălți de lavă în timp ce se rostogolește, iar atingerea lui dă foc inamicului. Inamicul arde cât stă în lavă."
          }
        }
      }
    },
