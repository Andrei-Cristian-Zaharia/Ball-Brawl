    "Allow Ball Brawl to see your friends in Settings › Game Center to invite them here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube Ball Brawl unter Einstellungen › Game Center, deine Freunde zu sehen, um sie hier einzuladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que Ball Brawl vea a tus amigos en Ajustes › Game Center para invitarlos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise Ball Brawl à voir tes amis dans Réglages › Game Center pour les inviter ici."
          }
