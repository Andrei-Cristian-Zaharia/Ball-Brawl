        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai lipsit prea mult și ai părăsit lupta."
          }
        }
      }
    },
    "Your %@ survived with %lld HP. Keep it in, or swap in a teammate.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein %@ hat mit %lld HP überlebt. Lass ihn drin oder wechsle ein Teammitglied ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
