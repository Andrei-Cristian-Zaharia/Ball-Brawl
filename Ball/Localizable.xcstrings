          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las trampas sujetan 0.3s más. Cada 4.5s, lanza una cadena al enemigo (4 de daño) que lo sujeta durante 0.3s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
