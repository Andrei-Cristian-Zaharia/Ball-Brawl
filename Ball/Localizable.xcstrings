    "Two smaller balls that both bite on contact. Only the main one can be hurt; its twin keeps bouncing in to help.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei kleinere Bälle, die beide bei Berührung beißen. Nur der Hauptball kann verletzt werden; sein Zwilling springt immer wieder zur Hilfe ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos bolas pequeñas que muerden al contacto. Solo la principal puede recibir daño; su gemela sigue rebotando para ayudar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux petites balles qui mordent toutes les deux au contact. Seule la principale peut être blessée ; son jumeau continue de rebondir pour l'aider."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas bolas menores que mordem ao encostar. Só a principal pode ser ferida; a gêmea segue quicando para ajudar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Două bile mai mici care mușcă amândouă la contact. Doar cea principală poate fi rănită; geamăna ei sare mereu în ajutor."
          }
        }
      }
    },
