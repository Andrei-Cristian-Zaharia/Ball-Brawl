    "Plants ball-sized trap zones like mines, up to 4 at once. An enemy that rolls into one is locked in place and hurt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt ballgroße Fallenzonen wie Minen, bis zu 4 gleichzeitig. Ein Gegner, der hineinrollt, wird festgehalten und verletzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Planta trampas del tamaño de una bola como minas, hasta 4 a la vez. Un enemigo que cae en una queda inmovilizado y herido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose des zones-pièges de la taille d'une balle, comme des mines, jusqu'à 4 à la fois. Un ennemi qui roule dessus est bloqué sur place et blessé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Planta zonas-armadilha do tamanho de uma bola, como minas, até 4 por vez. O inimigo que rolar numa fica preso e leva dano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plantează zone-capcană cât o bilă, ca niște mine, până la 4 deodată. Un inamic care intră într-una e blocat pe loc și rănit."
          }
        }
      }
    },
