          }
        }
      }
    },
    "Touching the enemy infects it with poison that keeps hurting over time. Repeated touches stack.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berührt er den Gegner, infiziert er ihn mit Gift, das mit der Zeit Schaden macht. Mehrere Berührungen stapeln sich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar al enemigo lo infecta con un veneno que daña con el tiempo. Los toques repetidos se acumulan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher l'ennemi l'infecte d'un poison qui le blesse dans la durée. Les contacts répétés se cumulent."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocar no inimigo o infecta com um veneno que fere com o tempo. Toques repetidos acumulam."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atingerea inamicului îl infectează cu otravă care îl rănește în timp. Atingerile repetate se cumulează."
          }
        }
      }
    },
    "Training Camp": {
