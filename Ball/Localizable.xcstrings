    "Casts a random spell every few seconds: a homing Firebolt, a slowing Frost Nova, a Lightning strike or three Arcane Missiles.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wirkt alle paar Sekunden einen zufälligen Zauber: einen zielsuchenden Feuerpfeil, eine verlangsamende Frostnova, einen Blitzschlag oder drei Arkane Geschosse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanza un hechizo aleatorio cada pocos segundos: un Rayo de Fuego teledirigido, una Nova Helada que ralentiza, un Relámpago o tres Misiles Arcanos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance un sort au hasard toutes les quelques secondes : un Trait de feu à tête chercheuse, une Nova de givre ralentissante, un coup de Foudre ou trois Projectiles arcaniques."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lança um feitiço aleatório a cada poucos segundos: uma Bola de Fogo teleguiada, uma Nova Gélida que deixa lento, um Raio ou três Mísseis Arcanos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La câteva secunde aruncă o vrajă aleatorie: o Săgeată de foc cu autoghidare, o Nova de gheață care încetinește, un Fulger sau trei Proiectile arcane."
          }
        }
      }
    },
