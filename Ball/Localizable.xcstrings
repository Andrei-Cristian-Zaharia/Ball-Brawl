        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n-a răspuns la timp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未及时回应。"
          }
        }
      }
    },
    "%@ has a different version of the game.": {
