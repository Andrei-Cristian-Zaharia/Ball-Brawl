          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 4s, suelta un anillo de 6 espinas (2 de daño cada una). Un golpe de espina rearma la embestida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 4s, projette un anneau de 6 épines (2 dégâts chacune). Une épine qui touche réarme le bélier."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 4s, solta um anel de 6 espinhos (2 de dano cada). Um espinho que acerta recarrega a investida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 4s leapădă un inel de 6 spini (2 daune fiecare). Un spin care nimerește reîncarcă izbitura."
