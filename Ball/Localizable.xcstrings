        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 3.5s, suelta un anillo de 6 chispas (3 de daño cada una)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 3.5s, projette un anneau de 6 étincelles (3 dégâts chacune)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 3.5s, solta um anel de 6 faíscas (3 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 3.5s aruncă un inel de 6 scântei (3 daune fiecare)."
          }
        }
      }
    },
    "Every 4s, 3 homing stars (1.5 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 4s 3 zielsuchende Sterne (je 1,5 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 4s, 3 estrellas teledirigidas (1.5 de daño cada una)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 4s, 3 étoiles à tête chercheuse (1.5 dégât chacune)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 4s, 3 estrelas teleguiadas (1.5 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 4s, 3 stele cu autoghidare (1.5 daune fiecare)."
          }
        }
      }
    },
    "Every 4s, a homing fireball (5 damage) that burns 2 per second for 2s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 4s ein zielsuchender Feuerball (5 Schaden), der 2s lang 2 pro Sekunde brennt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 4s, una bola de fuego teledirigida (5 de daño) que quema 2 por segundo durante 2s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 4s, une boule de feu à tête chercheuse (5 dégâts) qui brûle 2 par seconde pendant 2s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 4s, uma bola de fogo teleguiada (5 de dano) que queima 2 por segundo por 2s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 4s, o minge de foc cu autoghidare (5 daune) care arde 2 pe secundă timp de 2s."
          }
        }
      }
    },
    "Every 4s, fires a quick laser bolt at the enemy (4 damage).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 4s feuert er einen schnellen Laserblitz auf den Gegner (4 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 4s, dispara un rápido rayo láser al enemigo (4 de daño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 4s, tire un éclair laser rapide sur l'ennemi (4 dégâts)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 4s, dispara um raio laser rápido no inimigo (4 de dano)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 4s trage un proiectil laser rapid în inamic (4 daune)."
          }
        }
      }
    },
    "Every 4s, lobs a shell where the enemy is (5 damage).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 4s feuert er eine Granate dorthin, wo der Gegner ist (5 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 4s, lanza un proyectil donde está el enemigo (5 de daño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 4s, envoie un obus là où se trouve l'ennemi (5 dégâts)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 4s, lança um projétil onde o inimigo está (5 de dano)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 4s lansează un obuz acolo unde e inamicul (5 daune)."
          }
        }
      }
    },
    "Every 4s, puffs out 6 pollen spores (1 damage each) that slow the enemy by 25% for 1.5s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle 4s pustet er 6 Pollensporen aus (je 1 Schaden), die den Gegner 1,5s lang um 25% verlangsamen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada 4s, suelta 6 esporas de polen (1 de daño cada una) que ralentizan al enemigo un 25% durante 1.5s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les 4s, souffle 6 spores de pollen (1 dégât chacune) qui ralentissent l'ennemi de 25% pendant 1.5s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A cada 4s, solta 6 esporos de pólen (1 de dano cada) que deixam o inimigo 25% mais lento por 1.5s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiecare 4s suflă 6 spori de polen (1 daună fiecare) care încetinesc inamicul cu 25% timp de 1.5s."
          }
        }
