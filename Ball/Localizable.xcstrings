    "Latches onto a nearby opponent with a tether, draining its health and healing itself with most of what it steals — even past full health.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hängt sich mit einem Band an einen nahen Gegner, saugt seine HP ab und heilt sich mit dem Großteil davon – sogar über volle HP hinaus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se engancha a un rival cercano con un lazo, drena su salud y se cura con casi todo lo que roba, incluso por encima de la salud máxima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'accroche à un adversaire proche avec un lien, draine sa vie et se soigne avec presque tout ce qu'il vole — même au-delà de ses PV max."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prende-se a um oponente próximo com um laço, drenando sua vida e se curando com quase tudo que rouba — até além da vida máxima."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agață de un adversar din apropiere cu o legătură, îi drenează viața și se vindecă cu mare parte din ce fură — chiar și peste HP-ul maxim."
          }
        }
      }
    },
