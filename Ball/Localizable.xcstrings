    "After each rewind it springs at the enemy: twice as fast for 1s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach jedem Zurückspulen springt er auf den Gegner zu: 1s lang doppelt so schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras cada rebobinado salta hacia el enemigo: el doble de rápido durante 1s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque retour arrière, il bondit sur l'ennemi : deux fois plus vite pendant 1s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "巻き戻すたびに敵へ飛びかかる：1秒間スピード2倍。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되감기 후마다 적에게 달려들어요: 1초 동안 2배 빨라져요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após cada retrocesso, salta no inimigo: 2× mais rápido por 1s."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "După fiecare derulare sare la inamic: de două ori mai rapid timp de 1s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次回溯后扑向敌人：1 秒内速度翻倍。"
          }
        }
      }
    },
