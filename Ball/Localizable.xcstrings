    "Blink": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blink"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parpadeo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfert"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Piscar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salt"
          }
        }
      }
    },
    "Blinks toward the enemy every couple of seconds, zapping it if it lands close, and leaves an error tile behind. Rolling over a tile hurts and freezes the enemy for a moment.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinkt alle paar Sekunden zum Gegner, schockt ihn, wenn er nah landet, und hinterlässt eine Fehlerkachel. Wer über eine Kachel rollt, nimmt Schaden und friert kurz ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se teletransporta hacia el enemigo cada par de segundos, electrocutándolo si cae cerca, y deja una casilla de error detrás. Pasar sobre una casilla daña y congela al enemigo un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se téléporte vers l'ennemi toutes les deux secondes environ, l'électrocute s'il atterrit près de lui, et laisse une case d'erreur derrière lui. Rouler sur une case blesse l'ennemi et le fige un instant."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisca até o inimigo a cada poucos segundos, eletrocutando-o se cair perto, e deixa um bloco de erro. Passar num bloco machuca e congela o inimigo por um instante."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La câteva secunde sare spre inamic, îl electrocutează dacă aterizează aproape și lasă în urmă o dală de eroare. Rostogolirea peste o dală doare și îngheață inamicul o clipă."
          }
        }
      }
    },
    "Blinks zap 2 harder. Every 5s, the enemy lags: frozen for 0.6s.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blinks schocken 2 härter. Alle 5s laggt der Gegner: 0,6s eingefroren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los saltos electrocutan 2 más fuerte. Cada 5s, el enemigo sufre lag: congelado durante 0.6s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
