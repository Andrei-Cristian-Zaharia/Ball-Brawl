    "Charges from damage. All its dice turn golden (5s and 6s only) and roll at the enemy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Alle seine Würfel werden golden (nur 5 und 6) und rollen auf den Gegner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Todos sus dados se vuelven dorados (solo 5 y 6) y ruedan hacia el enemigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Tous ses dés deviennent dorés (5 et 6 uniquement) et roulent vers l'ennemi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Todos os dados viram dourados (só 5 e 6) e rolam no inimigo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Toate zarurile devin aurii (doar 5 și 6) și se rostogolesc spre inamic."
          }
        }
      }
    },
    "Charges from damage. Bursts into a ring of 14 shards (3 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Zerplatzt in einen Ring aus 14 Splittern (je 3 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Estalla en un anillo de 14 trozos (3 de daño cada uno)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Explose en un anneau de 14 éclats (3 dégâts chacun)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Explode num anel de 14 cacos (3 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Explodează într-un inel de 14 cioburi (3 daune fiecare)."
          }
        }
      }
    },
    "Charges from damage. Casts three different spells at once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Wirkt drei verschiedene Zauber auf einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Lanza tres hechizos distintos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Lance trois sorts différents d'un coup."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Lança três feitiços diferentes de uma vez."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Aruncă trei vrăji diferite deodată."
          }
        }
      }
    },
    "Charges from damage. Chains the enemy in place for 2s and deals 6 damage.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Kettet den Gegner 2s lang fest und macht 6 Schaden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Encadena al enemigo durante 2s y causa 6 de daño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Enchaîne l'ennemi sur place pendant 2s et inflige 6 dégâts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Acorrenta o inimigo no lugar por 2s e causa 6 de dano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Ține inamicul în lanțuri 2s și dă 6 daune."
          }
        }
      }
    },
    "Charges from damage. Drops a line of 5 bombs along the enemy's path (8 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Wirft eine Reihe aus 5 Bomben auf den Weg des Gegners (je 8 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Suelta una línea de 5 bombas en el camino del enemigo (8 de daño cada una)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Lâche une ligne de 5 bombes sur le chemin de l'ennemi (8 dégâts chacune)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Solta uma fila de 5 bombas no caminho do inimigo (8 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Lasă o linie de 5 bombe în calea inamicului (8 daune fiecare)."
          }
        }
      }
    },
    "Charges from damage. Every lava pool bursts at once (8 damage per blast).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Alle Lavapfützen explodieren auf einmal (je 8 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Todos los charcos de lava estallan a la vez (8 de daño por explosión)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Toutes les flaques de lave explosent d'un coup (8 dégâts par explosion)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Todas as poças de lava explodem juntas (8 de dano por explosão)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Toate bălțile de lavă explodează deodată (8 daune pe explozie)."
          }
        }
      }
    },
    "Charges from damage. For 2s it fires bolts in every direction (4 damage each).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Feuert 2s lang Bolzen in alle Richtungen (je 4 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Durante 2s dispara rayos en todas direcciones (4 de daño cada uno)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Pendant 2s, tire des projectiles dans toutes les directions (4 dégâts chacun)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Por 2s dispara projéteis em todas as direções (4 de dano cada)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Timp de 2s trage proiectile în toate direcțiile (4 daune fiecare)."
          }
        }
      }
    },
    "Charges from damage. For 3s it charges at the enemy; rams hit 25% harder and re-arm twice as fast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Stürmt 3s lang auf den Gegner zu; Rammstöße treffen 25% härter und laden doppelt so schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Durante 3s carga contra el enemigo; las embestidas golpean un 25% más fuerte y se rearman el doble de rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Pendant 3s, fonce sur l'ennemi ; les charges frappent 25% plus fort et se réarment deux fois plus vite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Por 3s avança no inimigo; investidas acertam 25% mais forte e recarregam 2× mais rápido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Timp de 3s șarjează inamicul; izbiturile lovesc cu 25% mai tare și se reîncarcă de două ori mai repede."
          }
        }
      }
    },
    "Charges from damage. For 3s it fires harpoons twice as fast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Feuert 3s lang Harpunen doppelt so schnell."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Durante 3s dispara arpones el doble de rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Pendant 3s, tire des harpons deux fois plus vite."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Por 3s dispara arpões 2× mais rápido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Timp de 3s trage harpoane de două ori mai repede."
          }
        }
      }
    },
    "Charges from damage. For 3s it hunts the enemy down, and its bites heal it for a third of their damage.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Jagt den Gegner 3s lang, und seine Bisse heilen ihn um ein Drittel ihres Schadens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Durante 3s persigue al enemigo y sus mordiscos lo curan un tercio del daño causado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Pendant 3s, traque l'ennemi, et ses morsures le soignent d'un tiers de leurs dégâts."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Por 3s caça o inimigo, e suas mordidas curam um terço do dano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Timp de 3s vânează inamicul, iar mușcăturile îl vindecă cu o treime din daune."
          }
        }
      }
    },
    "Charges from damage. For 3s lightning strikes the enemy every half second (4 damage).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. 3s lang schlägt jede halbe Sekunde ein Blitz in den Gegner ein (4 Schaden)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Durante 3s un rayo golpea al enemigo cada medio segundo (4 de daño)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Pendant 3s, la foudre frappe l'ennemi toutes les demi-secondes (4 dégâts)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Por 3s raios atingem o inimigo a cada meio segundo (4 de dano)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Timp de 3s, un fulger lovește inamicul la fiecare jumătate de secundă (4 daune)."
          }
        }
      }
    },
    "Charges from damage. For 4s it drains the enemy from anywhere (5 per second).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt sich durch Schaden auf. Saugt den Gegner 4s lang von überall aus (5 pro Sekunde)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carga con el daño. Durante 4s drena al enemigo desde cualquier lugar (5 por segundo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se charge en infligeant des dégâts. Pendant 4s, draine l'ennemi où qu'il soit (5 par seconde)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega com dano. Por 4s drena o inimigo de qualquer lugar (5 por segundo)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se încarcă din daune. Timp de 4s drenează inamicul de oriunde (5 pe secundă)."
          }
        }
      }
    },
    "Charges from damage. For 4s it plays its moves 2.5× as fast.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
